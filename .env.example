# BƯỚC 1 & BƯỚC 5: CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
BOT_TOKEN=1234567890:AAH7bX9k...ZyR2vQmT
CHAT_ID=
TIMEZONE=Asia/Ho_Chi_Minh

# BƯỚC 3: KẾT NỐI SUPABASE (Tùy chọn - Tự động dùng Local DB nếu để trống)
SUPABASE_URL=
SUPABASE_KEY=

# BƯỚC 6: ĐỊA CHỈ HTTPS SERVER TRÊN RENDER ĐỂ KẾT NỐI WEBHOOK
WEBHOOK_URL=

# BƯỚC 7: TÍCH HỢP AI NÂNG CAO (Tùy chọn)
GEMINI_API_KEY=

# BAO MAT KHI CHAY ONLINE (VERCEL): Khoa quan tri Dashboard.
# Dat ADMIN_KEY bat buoc tren Vercel - neu khong, cac API /api/* se bi chan
# (vi /api/state chua thong tin cau hinh). Dashboard se hoi khoa 1 lan/phien.
ADMIN_KEY=

# Tuy chon: Secret xac thuc Webhook Telegram (Telegram gui kem header
# X-Telegram-Bot-Api-Secret-Token). Dat cung gia tri khi bam Set Webhook o Buoc 6.
TELEGRAM_WEBHOOK_SECRET=

# Tuy chon: Thu muc ghi local DB (mac dinh: data/ o local, /tmp khi o Vercel)
# BOT_DATA_DIR=

# --- Cau noi tin hieu NexusPilot Pro (bot tu phat tin hieu dat chuan) ---
# Khoa chia se giua Cockpit va bot: Cockpit gui header X-Signal-Key khop gia tri nay
SIGNAL_KEY=
# Chat nhan tin hieu (ID so cua ban hoac cua nhom). De trong thi dung CHAT_ID
SIGNAL_CHAT_ID=
# Nguong diem toi thieu de phat tin hieu (mac dinh 80/100)
SIGNAL_MIN_SCORE=80
